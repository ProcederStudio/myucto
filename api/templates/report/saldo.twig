<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<title>Saldokonto</title>
<style>
    body { font-family: montserrat, dejavusans, sans-serif; font-size: 8pt; color: #15131D; }
    .header-table { width: 100%; border-collapse: collapse; margin-bottom: 4mm; }
    .header-table td { vertical-align: top; }
    .header-meta { font-size: 8pt; color: #555; }
    .header-title { font-size: 13pt; font-weight: bold; text-align: center; padding: 0 6mm; }
    .header-period { text-align: center; font-size: 10pt; margin-top: 2mm; }
    .header-sub { text-align: center; font-size: 8pt; color: #555; margin-top: 1mm; }
    .acc-title { font-size: 10pt; font-weight: bold; margin-top: 5mm; margin-bottom: 1mm; }
    .confront-table { width: 100%; border-collapse: collapse; margin-bottom: 2mm; }
    .confront-table td { padding: 1mm 2mm; font-size: 8pt; border: 0.2pt solid #ddd; }
    .confront-label { color: #555; width: 55mm; }
    .num { text-align: right; }
    .diff-ok { color: #166534; font-weight: bold; }
    .diff-fail { color: #b91c1c; font-weight: bold; }
    table.book { width: 100%; border-collapse: collapse; margin: 0; } /* bez okraje: šev mezi kusy tabulky nesmí dělat mezeru */
    table.book thead th {
        font-size: 7pt; font-weight: normal; color: #555; text-align: right;
        padding: 1mm 1.5mm; border-bottom: 0.3pt solid #ccc; vertical-align: bottom;
    }
    table.book thead th.thl { text-align: left; }
    table.book tbody td { padding: 0.8mm 1.5mm; font-size: 8pt; border-bottom: 0.2pt solid #eee; vertical-align: top; }
    .partner-row td { font-weight: bold; background-color: #f4f4f5; }
    /* Pevné šířky všech sloupců: dlouhá sestava se sází po kusech (ChunkedHtmlWriter)
       a kusy i hlavička stránky musí lícovat, proto procenta se součtem 100 %. */
    .col-doc { width: 16%; }
    .col-date { width: 10%; }
    .col-days { width: 8%; }
    .col-amount { width: 24%; }
    .col-num { width: 16%; }
    .overdue { color: #b91c1c; }
    .empty { text-align: center; color: #888; padding: 8mm 0; }
    .section-title { font-size: 11pt; font-weight: bold; margin-top: 2mm; margin-bottom: 1mm; }
    .section-sub { font-size: 8pt; color: #555; margin-bottom: 2mm; }
    table.book tfoot td { padding: 1mm 1.5mm; font-size: 8pt; font-weight: bold; border-top: 0.3pt solid #999; background-color: #f4f4f5; }
    .aging-partner { width: 28%; }
</style>
</head>
<body>

<table class="header-table">
    <tr>
        <td style="width:30%;">
            <div class="header-meta">{{ entity.name }}{% if entity.ico %} — IČO: {{ entity.ico }}{% endif %}</div>
            <div class="header-meta">{{ entity.address }}</div>
        </td>
        <td style="width:40%;">
            <div class="header-title">{{ report_title|default('Saldokonto') }}</div>
            <div class="header-period">k rozvahovému dni {{ as_of|cz_date }}</div>
            <div class="header-sub">Inventarizační protokol otevřených položek — fiskální rok {{ period.fiscal_year }}</div>
        </td>
        <td style="width:30%;" class="num">
            <div class="header-meta">Sestaveno: {{ entity.prepared_at }}</div>
        </td>
    </tr>
</table>

{% if accounts is empty %}
    <p class="empty">Pro zvolený rozvahový den nejsou na saldokontních účtech žádné zůstatky ani otevřené položky.</p>
{% endif %}

{% if aging is defined and aging and accounts is not empty %}
    {% set aging_width = (72 / (aging.buckets|length + 1))|round(3) %}
    <div class="section-title">Členění otevřených položek podle doby po splatnosti</div>
    <div class="section-sub">Zbývající částky v Kč podle počtu dní po splatnosti k {{ as_of|cz_date }}.</div>
    {% for acc in aging.accounts %}
        <div class="acc-title">Účet {{ acc.account.code }} — {{ acc.account.name }}</div>
        {% if acc.partners is empty %}
            <p class="empty" style="padding: 3mm 0;">Žádné otevřené položky na tomto účtu.</p>
        {% else %}
        <table class="book">
            <thead>
                <tr>
                    <th class="thl aging-partner">Partner</th>
                    {% for b in aging.buckets %}<th style="width:{{ aging_width }}%;">{{ b.label }}</th>{% endfor %}
                    <th style="width:{{ aging_width }}%;">Celkem</th>
                </tr>
            </thead>
            <tbody>
                {% for p in acc.partners %}
                <tr>
                    <td class="aging-partner">{{ p.partner_name }}</td>
                    {% for b in aging.buckets %}
                        <td class="num {{ b.key != 'not_due' and p.amounts[b.key] != 0 ? 'overdue' : '' }}" style="width:{{ aging_width }}%;">{{ p.amounts[b.key] != 0 ? p.amounts[b.key]|cz_money : '' }}</td>
                    {% endfor %}
                    <td class="num" style="width:{{ aging_width }}%;">{{ p.total|cz_money }}</td>
                </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <td class="aging-partner">Celkem</td>
                    {% for b in aging.buckets %}<td class="num" style="width:{{ aging_width }}%;">{{ acc.totals[b.key]|cz_money }}</td>{% endfor %}
                    <td class="num" style="width:{{ aging_width }}%;">{{ acc.total|cz_money }}</td>
                </tr>
            </tfoot>
        </table>
        {% endif %}
    {% endfor %}
{% endif %}

{% if show_detail is not defined or show_detail %}
{% if aging is defined and aging and accounts is not empty %}
    <pagebreak />
    <div class="section-title">Rozpis otevřených položek</div>
{% endif %}
{% for acc in accounts %}
    <div class="acc-title">Účet {{ acc.account.code }} — {{ acc.account.name }}</div>
    {% if acc.note %}<div class="header-sub" style="text-align:left; margin-bottom:2mm;">{{ acc.note }}</div>{% endif %}

    <table class="confront-table">
        <tr>
            <td class="confront-label">Zůstatek účtu z hlavní knihy</td>
            <td class="num">{{ acc.gl_balance|cz_money }} Kč</td>
            <td class="confront-label">Σ otevřených položek</td>
            <td class="num">{{ acc.open_items_total|cz_money }} Kč</td>
            <td class="confront-label">Rozdíl</td>
            <td class="num {{ acc.matches ? 'diff-ok' : 'diff-fail' }}">
                {{ acc.matches ? '✓ ' : '✗ ' }}{{ acc.difference|cz_money }} Kč
            </td>
        </tr>
    </table>

    {% if acc.partners is empty %}
        <p class="empty" style="padding: 3mm 0;">Žádné otevřené položky na tomto účtu.</p>
    {% else %}
    <table class="book">
        <thead>
            <tr>
                <th class="thl col-doc">Doklad</th>
                <th class="thl col-date">Vystaveno</th>
                <th class="thl col-date">Splatnost</th>
                <th class="col-days">Dní po spl.</th>
                <th class="col-amount">Částka</th>
                <th class="col-num">Uhrazeno</th>
                <th class="col-num">Zbývá (Kč)</th>
            </tr>
        </thead>
        <tbody>
            {% for p in acc.partners %}
                <tr class="partner-row">
                    <td colspan="6">{{ p.partner_name }}</td>
                    <td class="num col-num">{{ p.total_remaining|cz_money }}</td>
                </tr>
                {% for it in p.items %}
                    {% if it.kind is defined and it.kind == 'advance_pending' %}
                    {# Záloha čekající na vyúčtování: částka = platba, uhrazeno = daň z DDKP. #}
                    <tr>
                        <td class="col-doc">{{ it.doc_no }}<br><span style="color:#888">{{ it.label }}</span></td>
                        <td class="col-date">{{ it.issue_date|cz_date }}</td>
                        <td class="col-date">{{ it.due_date|cz_date }}</td>
                        <td class="num col-days"></td>
                        <td class="num col-amount">{{ it.advance_payment_czk|cz_money }}</td>
                        <td class="num col-num">{% if it.advance_vat_czk %}{{ it.advance_vat_czk|cz_money }}<br><span style="color:#888">DPH z daňového dokladu k platbě</span>{% endif %}</td>
                        <td class="num col-num">{{ it.remaining_czk|cz_money }}</td>
                    </tr>
                    {% else %}
                    <tr>
                        <td class="col-doc">{{ it.doc_no }}</td>
                        <td class="col-date">{{ it.issue_date|cz_date }}</td>
                        <td class="col-date">{{ it.due_date|cz_date }}</td>
                        <td class="num col-days {{ it.days_overdue > 0 ? 'overdue' : '' }}">{{ it.days_overdue > 0 ? it.days_overdue : '' }}</td>
                        <td class="num col-amount">{{ it.booked_czk|cz_money }}{% if it.currency_code != 'CZK' %} <span style="color:#888">({{ it.amount_foreign|cz_money }} {{ it.currency_code }})</span>{% endif %}</td>
                        <td class="num col-num">{{ it.paid_czk|cz_money }}</td>
                        <td class="num col-num">{{ it.remaining_czk|cz_money }}</td>
                    </tr>
                    {% endif %}
                {% endfor %}
            {% endfor %}
        </tbody>
    </table>
    {% endif %}
{% endfor %}
{% endif %}

</body>
</html>
