<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<title>Ocenění zásob</title>
<style>
    body { font-family: montserrat, dejavusans, sans-serif; font-size: 8pt; color: #15131D; }
    .header-title { font-size: 13pt; font-weight: bold; text-align: center; margin-bottom: 2mm; }
    table.book { width: 100%; border-collapse: collapse; margin: 0; } /* bez okraje: šev mezi kusy tabulky nesmí dělat mezeru */
    table.book thead th {
        font-size: 7pt; font-weight: normal; color: #555; text-align: right;
        padding: 1mm 1.5mm; border-bottom: 0.3pt solid #ccc; vertical-align: bottom;
    }
    table.book thead th.thl { text-align: left; }
    table.book tbody td { padding: 0.8mm 1.5mm; font-size: 8pt; border-bottom: 0.2pt solid #eee; vertical-align: top; }
    table.book tfoot td { font-weight: bold; font-size: 8pt; padding: 1.5mm 1.5mm; border-top: 0.5pt solid #333; }
    .num { text-align: right; }
    /* Pevné šířky všech sloupců: dlouhá sestava se sází po kusech (ChunkedHtmlWriter)
       a kusy i hlavička stránky musí lícovat, proto procenta se součtem 100 %. */
    .col-wh { width: 8%; }
    .col-sku { width: 14%; }
    .col-name { width: 44%; }
    .col-unit { width: 6%; }
    .col-qty { width: 13%; }
    .col-value { width: 15%; }
</style>
</head>
<body>

<div class="header-title">Ocenění zásob k {{ date|cz_date }}</div>

{% if category_groups is defined and category_groups is not null %}
{# Souhrn podle kategorií (StockValuationCategoryGroups); popisky a poznámku dodává renderer. #}
<table class="book" style="width: 60%; margin-bottom: 4mm;">
    <thead>
        <tr>
            <th class="thl" style="width: 64%;">Kategorie{% if category_groups.parent %}: {{ category_groups.parent.name }}{% endif %}</th>
            <th style="width: 14%;">Položek</th>
            <th style="width: 22%;">Hodnota</th>
        </tr>
    </thead>
    <tbody>
        {% for group in category_groups.groups %}
            <tr>
                <td>{{ group_labels[loop.index0] }}</td>
                <td class="num">{{ group.count }}</td>
                <td class="num">{{ group.value_total|cz_money }}</td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <td>CELKEM</td>
            <td class="num">{{ category_groups.count }}</td>
            <td class="num">{{ category_groups.value_total|cz_money }}</td>
        </tr>
    </tfoot>
</table>
<p style="font-size: 7pt; color: #555; margin: 0 0 4mm 0;">{{ group_note }}</p>
{% endif %}

{% if items is empty %}
    <p style="text-align:center; color:#888; padding: 10mm 0;">K tomuto datu neexistuje žádný nenulový stav zásob.</p>
{% else %}
<table class="book">
    <thead>
        <tr>
            <th class="thl col-wh">Sklad</th>
            <th class="thl col-sku">SKU</th>
            <th class="thl col-name">Název</th>
            <th class="thl col-unit">MJ</th>
            <th class="col-qty">Množství</th>
            <th class="col-value">Hodnota</th>
        </tr>
    </thead>
    <tbody>
        {% for row in items %}
            <tr>
                <td class="col-wh">{{ row.warehouse_code }}</td>
                <td class="col-sku">{{ row.sku }}</td>
                <td class="col-name">{{ row.name|slice(0, 60) }}</td>
                <td class="col-unit">{{ row.unit }}</td>
                <td class="num col-qty">{{ row.qty|cz_money }}</td>
                <td class="num col-value">{{ row.value_total|cz_money }}</td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <td colspan="5">CELKEM ({{ totals.count }} položek)</td>
            <td class="num">{{ totals.value_total|cz_money }}</td>
        </tr>
    </tfoot>
</table>
{% endif %}

</body>
</html>
