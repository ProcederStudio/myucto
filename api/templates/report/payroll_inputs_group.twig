<table class="inputs">
    <tbody>
        <tr class="group-head">
            <td style="width:46%;">{{ group.name }}{% if group.personal_numbers %} <span class="muted">· {{ group.personal_numbers }}</span>{% endif %}</td>
            <td style="width:8%;"></td>
            <td style="width:8%;" class="num muted">{{ group.count }}×</td>
            <td style="width:11%;" class="num">{{ group.amount }}</td>
            <td style="width:12%;"></td>
            <td style="width:15%;"></td>
        </tr>
        {% for row in group.rows %}
            <tr>
                <td>{{ row.component_name }}{% if row.personal_number != group.personal_numbers %} <span class="muted">· {{ row.personal_number }}</span>{% endif %}</td>
                <td class="num">{{ row.quantity }}</td>
                <td class="num">{{ row.rate }}</td>
                <td class="num">{{ row.amount }}</td>
                <td>{{ row.status }}</td>
                <td>{{ row.source }}{% if row.import %} <span class="muted">{{ row.import }}</span>{% endif %}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
